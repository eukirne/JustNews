# Required: get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for reframing. Override if you want a specific dated snapshot.
CLAUDE_MODEL=claude-sonnet-5

# SQLite by default. For Postgres use e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/brightside
DATABASE_URL=sqlite:///./brightside.db

# How many top (deduplicated) stories to reframe per pipeline run
STORIES_PER_REFRESH=15

# Minutes between scheduled pipeline runs
REFRESH_INTERVAL_MINUTES=45

# User-Agent sent when fetching feeds / og:image pages
FETCH_USER_AGENT=TheBrightSideBot/1.0 (+https://example.com/about-bot)

# Comma-separated origins allowed to call the API from the browser
CORS_ORIGINS=http://localhost:3000
